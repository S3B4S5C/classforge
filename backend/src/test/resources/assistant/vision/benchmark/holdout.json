      "expectedOutcome": "PLAN",
      "existingClasses": [],
      "expectedSignatures": [
        "CREATE_CLASS|Cliente|id:UUID",
        "CREATE_CLASS|LineaPedido|cantidad:INTEGER",
        "CREATE_CLASS|Pedido|fecha:DATE",
        "CREATE_RELATIONSHIP|Cliente|Pedido|ASSOCIATION|null:null|null:null",
        "CREATE_RELATIONSHIP|Pedido|LineaPedido|ASSOCIATION|null:null|null:null"
      ]
    },
    {
      "id": "existing-mascota-attribute",
      "image": "/assistant/vision/benchmark/holdout/existing-mascota-attribute.png",
      "expectedOutcome": "PLAN",
      "existingClasses": [
        {
          "name": "Mascota",
          "attributes": ["nombre"]
        }
      ],
      "expectedSignatures": [
        "ADD_ATTRIBUTES|Mascota|pesoKg:DECIMAL"
      ]
    },
    {
