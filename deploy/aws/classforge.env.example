# Copy to /etc/classforge/classforge.env, chmod 600, and replace every CHANGE_ME.

# MongoDB replica set (Atlas or a separately managed replica set). Replace before starting.
CLASSFORGE_MONGODB_URI=CHANGE_ME_MONGODB_REPLICA_SET_URI

# All AI runs on Groq. Keep the real key only in this server-side environment file.
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GROQ_REQUEST_TIMEOUT_MILLIS=90000

CLASSFORGE_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS

# After CloudFront exists, replace this with its exact origin, for example:
# https://d1234567890abc.cloudfront.net
CLASSFORGE_WEBSOCKET_ALLOWED_ORIGINS=https://*.cloudfront.net

# Vision pipeline remains configurable without changing code.
CLASSFORGE_ASSISTANT_VISION_TWO_PASS=false
CLASSFORGE_ASSISTANT_VISION_HYBRID=true
CLASSFORGE_ASSISTANT_VISION_HYBRID_MIN_CLASSES=4
CLASSFORGE_ASSISTANT_VISION_HYBRID_FALLBACK=false
