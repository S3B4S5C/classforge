[Unit]
Description=ClassForge Spring Boot (AWS demo)
After=network-online.target classforge-whisper.service
Wants=network-online.target classforge-whisper.service

[Service]
Type=simple
User=classforge
Group=classforge
WorkingDirectory=/opt/classforge
EnvironmentFile=/etc/classforge/classforge.env
ExecStart=/usr/bin/java -jar /opt/classforge/app/classforge.jar --spring.profiles.active=aws-demo
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/classforge/data

[Install]
WantedBy=multi-user.target
