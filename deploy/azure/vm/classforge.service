[Unit]
Description=ClassForge (Azure VM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=classforge
Group=classforge
WorkingDirectory=/opt/classforge
EnvironmentFile=/etc/classforge/classforge.env
ExecStartPre=/opt/classforge/bin/check-environment.sh
ExecStart=/usr/bin/java -Xms128m -Xmx768m -XX:+ExitOnOutOfMemoryError --enable-native-access=ALL-UNNAMED -jar /opt/classforge/current/app.jar --spring.profiles.active=azure,azure-vm
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
SuccessExitStatus=143
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/classforge/data

[Install]
WantedBy=multi-user.target
